let currentLang = (typeof localStorage !== 'undefined' && localStorage.getItem('CLYNORA_lang')) || 'en';

function setLanguage(lang) {
  if (!TRANSLATIONS[lang]) lang = 'en';
  currentLang = lang;
  try {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('CLYNORA_lang', lang);
    }
  } catch (e) {}

  if (typeof document !== 'undefined' && document.documentElement) {
    document.documentElement.lang = lang;
  }
  
  // 1. Synchronize all language selector dropdowns across headers, topbars, and voice overlays
  if (typeof document !== 'undefined') {
    document.querySelectorAll('select.lang-select, select[onchange*="setLanguage"], #voiceLangSelect').forEach(sel => {
      sel.value = lang;
    });

    // 2. Update all elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (TRANSLATIONS[lang] && TRANSLATIONS[lang][key]) {
        el.textContent = TRANSLATIONS[lang][key];
      } else if (TRANSLATIONS['en'] && TRANSLATIONS['en'][key]) {
        el.textContent = TRANSLATIONS['en'][key];
      }
    });

    // 3. Update placeholders with data-i18n-ph
    document.querySelectorAll('[data-i18n-ph]').forEach(el => {
      const key = el.getAttribute('data-i18n-ph');
      if (TRANSLATIONS[lang] && TRANSLATIONS[lang][key]) {
        el.placeholder = TRANSLATIONS[lang][key];
      } else if (TRANSLATIONS['en'] && TRANSLATIONS['en'][key]) {
        el.placeholder = TRANSLATIONS['en'][key];
      }
    });

    // 4. Update titles / tooltips with data-i18n-title
    document.querySelectorAll('[data-i18n-title]').forEach(el => {
      const key = el.getAttribute('data-i18n-title');
      if (TRANSLATIONS[lang] && TRANSLATIONS[lang][key]) {
        el.title = TRANSLATIONS[lang][key];
      }
    });
  }

  // 5. Update Navigation Header
  if (typeof updateNavHeader === 'function') {
    updateNavHeader();
  }

  // 6. Re-render current application view if user is in workspace
  if (typeof draw === 'function' && typeof window !== 'undefined' && window.U) {
    draw();
  }
  
  // 7. Update assistant drawer prompts and welcome if open
  if (typeof renderRolePrompts === 'function') {
    renderRolePrompts();
  }
  
  // 8. Re-render voice orb labels & transcript if active
  if (typeof updateOrbLanguage === 'function') {
    updateOrbLanguage();
  }
}

function t(key) {
  if (TRANSLATIONS[currentLang] && TRANSLATIONS[currentLang][key] !== undefined) {
    return TRANSLATIONS[currentLang][key];
  }
  if (TRANSLATIONS['en'] && TRANSLATIONS['en'][key] !== undefined) {
    return TRANSLATIONS['en'][key];
  }
  return key;
}

// Automatically apply language preference on load
if (typeof document !== 'undefined') {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setLanguage(currentLang));
  } else {
    setLanguage(currentLang);
  }
}
